# Server-only secrets (never prefix these with EXPO_PUBLIC_)
MONGODB_URI=mongodb+srv://<database-user>:<password>@<cluster-host>/
MONGODB_DB=khadamati
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Set this to the deployed API origin for Android/iOS builds.
# For the web deployment on the same Vercel project, leave it empty.
EXPO_PUBLIC_API_BASE_URL=
